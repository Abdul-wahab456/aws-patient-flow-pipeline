{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListLakeBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::__LAKE__"
    },
    {
      "Sid": "ReadBronzeAndScripts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": ["arn:aws:s3:::__LAKE__/bronze/*", "arn:aws:s3:::__LAKE__/glue_scripts/*"]
    },
    {
      "Sid": "ReadWriteSilverAndTemp",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::__LAKE__/silver/*", "arn:aws:s3:::__LAKE__/temp/*"]
    }
  ]
}
