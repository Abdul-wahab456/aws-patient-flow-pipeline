{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListLandingAndBronze",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__LAKE__",
      "Condition": { "StringLike": { "s3:prefix": ["landing/*", "bronze/*"] } }
    },
    {
      "Sid": "ReadLanding",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::__LAKE__/landing/*"
    },
    {
      "Sid": "WriteBronze",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::__LAKE__/bronze/*"
    }
  ]
}
